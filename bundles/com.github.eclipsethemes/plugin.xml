<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
	<extension-point id="com.github.eclipsethemes.theme.adapters" name="Theme Adapter" schema="schema/com.github.eclipsethemes.theme.adapters.exsd"/>
	<extension
         point="org.eclipse.ui.preferencePages">
		<page
			category="org.eclipse.ui.preferencePages.Views"
            class="com.github.eclipsethemes.eclipse.preferences.EclipseThemesPreferencePage"
            id="com.github.eclipsethemes.eclipse.preferences.EclipseThemesPreferencePage"
            name="Eclipse Themes"></page>
	</extension>
	<extension
         point="org.eclipse.core.runtime.preferences">
		<initializer
            class="com.github.eclipsethemes.eclipse.preferences.PreferenceInitializer"></initializer>
	</extension>
	<extension
         point="com.github.eclipsethemes.theme.adapters">
		<adapter
            class="com.github.eclipsethemes.eclipse.adapters.editor.TextEditorThemeAdapter" plugin="org.eclipse.ui.editors"></adapter>
		<adapter
            class="com.github.eclipsethemes.eclipse.adapters.ui.DebugConsoleThemeAdapter"
            plugin="org.eclipse.debug.ui"></adapter>
		<adapter
            class="com.github.eclipsethemes.eclipse.adapters.editor.CppEditorThemeAdapter"
            plugin="org.eclipse.cdt.ui"></adapter>
		<adapter
            class="com.github.eclipsethemes.eclipse.adapters.editor.JavaEditorThemeAdapter" plugin="org.eclipse.jdt.ui"></adapter>
		<adapter
            class="com.github.eclipsethemes.eclipse.adapters.editor.PluginEditorThemeAdapter" plugin="org.eclipse.pde.ui"></adapter>
		<adapter
            class="com.github.eclipsethemes.eclipse.adapters.editor.AntEditorThemeAdapter"
            plugin="org.eclipse.ant.ui"></adapter>
	</extension>
	<extension
         point="org.eclipse.e4.ui.css.swt.theme">
		<theme id="com.github.eclipsethemes.workbench.dark" label="Eclipse Themes Dark" basestylesheeturi="css/workbench-dark.css"></theme>
		<theme id="com.github.eclipsethemes.workbench.dark.alt" label="Eclipse Themes Dark (alternate)" basestylesheeturi="css/workbench-dark.css"></theme>
		<theme id="com.github.eclipsethemes.workbench.light" label="Eclipse Themes Light" basestylesheeturi="css/workbench-light.css"></theme>
		<theme id="com.github.eclipsethemes.workbench.light.alt" label="Eclipse Themes Light (alternate)" basestylesheeturi="css/workbench-light.css"></theme>
	</extension>
	<extension
         point="org.eclipse.ui.themes">
		<colorDefinition id="com.github.eclipsethemes.workbench.dark.background" isEditable="false" label="Eclipse Themes workbench dark background" value="30,30,30"></colorDefinition>
		<colorDefinition id="com.github.eclipsethemes.workbench.dark.foreground" isEditable="false" label="Eclipse Themes workbench dark foreground" value="212,212,212"></colorDefinition>
		<colorDefinition id="com.github.eclipsethemes.workbench.dark.surface" isEditable="false" label="Eclipse Themes workbench dark surface" value="37,37,38"></colorDefinition>
		<colorDefinition id="com.github.eclipsethemes.workbench.dark.raised" isEditable="false" label="Eclipse Themes workbench dark raised" value="45,45,48"></colorDefinition>
		<colorDefinition id="com.github.eclipsethemes.workbench.dark.border" isEditable="false" label="Eclipse Themes workbench dark border" value="60,60,60"></colorDefinition>
		<colorDefinition id="com.github.eclipsethemes.workbench.dark.muted" isEditable="false" label="Eclipse Themes workbench dark muted" value="157,157,157"></colorDefinition>
		<colorDefinition id="com.github.eclipsethemes.workbench.dark.selection" isEditable="false" label="Eclipse Themes workbench dark selection" value="38,79,120"></colorDefinition>
		<colorDefinition id="com.github.eclipsethemes.workbench.dark.accent" isEditable="false" label="Eclipse Themes workbench dark accent" value="90,162,232"></colorDefinition>
		<colorDefinition id="com.github.eclipsethemes.workbench.light.background" isEditable="false" label="Eclipse Themes workbench light background" value="255,255,255"></colorDefinition>
		<colorDefinition id="com.github.eclipsethemes.workbench.light.foreground" isEditable="false" label="Eclipse Themes workbench light foreground" value="31,31,31"></colorDefinition>
		<colorDefinition id="com.github.eclipsethemes.workbench.light.surface" isEditable="false" label="Eclipse Themes workbench light surface" value="243,243,243"></colorDefinition>
		<colorDefinition id="com.github.eclipsethemes.workbench.light.raised" isEditable="false" label="Eclipse Themes workbench light raised" value="232,232,232"></colorDefinition>
		<colorDefinition id="com.github.eclipsethemes.workbench.light.border" isEditable="false" label="Eclipse Themes workbench light border" value="206,206,206"></colorDefinition>
		<colorDefinition id="com.github.eclipsethemes.workbench.light.muted" isEditable="false" label="Eclipse Themes workbench light muted" value="107,107,107"></colorDefinition>
		<colorDefinition id="com.github.eclipsethemes.workbench.light.selection" isEditable="false" label="Eclipse Themes workbench light selection" value="204,228,247"></colorDefinition>
		<colorDefinition id="com.github.eclipsethemes.workbench.light.accent" isEditable="false" label="Eclipse Themes workbench light accent" value="11,97,196"></colorDefinition>
	</extension>
	<extension
         point="org.eclipse.ui.startup">
		<startup
            class="com.github.eclipsethemes.eclipse.workbench.WorkbenchStartup"></startup>
	</extension>
</plugin>
