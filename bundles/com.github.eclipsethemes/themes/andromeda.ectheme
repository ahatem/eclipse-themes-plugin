    <comment color="#87888f"/>
    <constant color="#00e8c6"/>
    <currentLine color="#2e323d"/>
    <deprecated color="#d5ced9" strikethrough="true"/>
    <doc color="#87888f"/>
    <docLink color="#d5ced9"/>
    <docTag color="#c74ded"/>
    <docXmlTag color="#f92672"/>
    <enum color="#ffe66d"/>
    <field color="#00e8c6"/>
    <filteredSearchResult color="#3c6a6c"/>
    <findScope color="#2c2f36"/>
    <inheritedMethod color="#ffe66d"/>
    <interface color="#ffe66d"/>
    <keyword color="#c74ded"/>
    <lineNumber color="#746f77"/>
    <localVariable color="#00e8c6"/>
    <localVariableDeclaration color="#00e8c6"/>
    <method color="#ffe66d"/>
    <methodDeclaration color="#ffe66d"/>
    <multiLineComment color="#87888f"/>
    <number color="#f39c12"/>
    <occurrence color="#4f4355"/>
    <operator color="#ee5d43"/>
    <removedLine color="#c25345"/>
    <searchResult color="#694e25"/>
    <selectionBackground color="#3d4352"/>
    <selectionForeground color="#d5ced9"/>
    <sourceHoverBackground color="#373941"/>
    <staticField color="#00e8c6"/>
    <staticFinalField color="#00e8c6"/>
    <staticMethod color="#ffe66d"/>
    <string color="#96e072"/>
    <taskTag color="#87888f" bold="true"/>
