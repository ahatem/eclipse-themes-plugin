<?xml version="1.0" encoding="UTF-8"?>
<themePackage schemaVersion="1" id="com.github.eclipsethemes.andromeda" name="Andromeda" appearance="dark" author="Eliver Lara" website="https://github.com/EliverLara/Andromeda" version="1.10.0">
  <provenance license="MIT" copyright="Eliver Lara" source="https://github.com/EliverLara/Andromeda/tree/d1abb48c69493000aa0133a32d594eb25e523d4f"/>
  <editor>
    <background color="#23262e"/>
    <foreground color="#d5ced9"/>
