<?xml version="1.0" encoding="UTF-8"?>
<themePackage schemaVersion="1" id="com.github.eclipsethemes.catppuccin-macchiato" name="Catppuccin Macchiato" appearance="dark" author="Catppuccin" website="https://github.com/catppuccin/vscode" version="3.18.1">
  <provenance license="MIT" copyright="Catppuccin" source="https://github.com/catppuccin/vscode"/>
  <editor>
    <background color="#24273a"/>
    <foreground color="#cad3f5"/>
    <abstractClass color="#eed49f" italic="true"/>
    <abstractMethod color="#8aadf4" italic="true"/>
    <annotation color="#f5a97f"/>
    <argument color="#ee99a0" italic="true"/>
    <bracket color="#939ab7"/>
    <class color="#eed49f" italic="true"/>
    <comment color="#939ab7" italic="true"/>
    <constant color="#f5a97f"/>
    <currentLine color="#303347"/>
    <deprecated color="#cad3f5" strikethrough="true"/>
    <doc color="#939ab7" italic="true"/>
    <docLink color="#8aadf4"/>
    <docTag color="#c6a0f6"/>
    <docXmlTag color="#8aadf4"/>
    <enum color="#eed49f" italic="true"/>
    <field color="#cad3f5"/>
    <filteredSearchResult color="#455c6d"/>
    <findScope color="#455c6d"/>
    <inheritedMethod color="#8aadf4" italic="true"/>
    <interface color="#eed49f" italic="true"/>
    <keyword color="#c6a0f6"/>
    <lineNumber color="#8087a2"/>
    <localVariable color="#cad3f5"/>
    <localVariableDeclaration color="#cad3f5"/>
    <method color="#8aadf4" italic="true"/>
    <methodDeclaration color="#8aadf4" italic="true"/>
    <multiLineComment color="#939ab7" italic="true"/>
    <number color="#f5a97f"/>
    <occurrence color="#3a3e53"/>
    <operator color="#8bd5ca"/>
    <removedLine color="#ed8796"/>
    <searchResult color="#604456"/>
    <selectionBackground color="#404459"/>
    <selectionForeground color="#cad3f5"/>
    <sourceHoverBackground color="#1e2030"/>
    <staticField color="#cad3f5"/>
    <staticFinalField color="#f5a97f"/>
    <staticMethod color="#8aadf4" italic="true"/>
    <string color="#a6da95"/>
    <taskTag color="#939ab7" bold="true"/>
    <templateArgument color="#eed49f" italic="true"/>
    <templateParameter color="#eed49f" italic="true"/>
    <writeOccurrence color="#38425f"/>
    <xmlAttribute color="#eed49f"/>
    <xmlComment color="#939ab7" italic="true"/>
    <xmlTag color="#8aadf4"/>
  </editor>
  <workbench>
    <background color="#24273a"/>
    <foreground color="#cad3f5"/>
    <surface color="#1e2030"/>
    <surfaceRaised color="#24273a"/>
    <border color="#5b6078"/>
    <mutedForeground color="#cad3f5"/>
    <selection color="#363a4f"/>
    <accent color="#c6a0f6"/>
  </workbench>
</themePackage>
