<?xml version="1.0" encoding="UTF-8"?>
<themePackage schemaVersion="1" id="com.github.eclipsethemes.intellij-dark" name="IntelliJ Dark" appearance="dark" author="JetBrains" website="https://github.com/JetBrains/intellij-community" version="intellij-community 536da82">
  <provenance license="Apache-2.0" copyright="JetBrains s.r.o." source="https://github.com/JetBrains/intellij-community/tree/536da82a2cbce90820cbb0c158d91e78cda75d82/platform/platform-resources/src"/>
  <editor>
    <background color="#1e1f22"/>
    <foreground color="#bcbec4"/>
    <abstractClass color="#bcbec4"/>
    <abstractMethod color="#bcbec4"/>
    <annotation color="#b3ae60"/>
    <argument color="#bcbec4"/>
    <bracket color="#bcbec4"/>
    <class color="#bcbec4"/>
    <comment color="#7a7e85"/>
    <constant color="#c77dbb" italic="true"/>
    <currentLine color="#26282e"/>
    <deprecated color="#bcbec4" strikethrough="true"/>
    <doc color="#5f826b" italic="true"/>
    <docLink color="#abadb3"/>
    <docTag color="#67a37c"/>
    <docXmlTag color="#68a67e"/>
    <enum color="#bcbec4"/>
    <field color="#c77dbb"/>
    <filteredSearchResult color="#114957"/>
    <inheritedMethod color="#bcbec4"/>
    <interface color="#bcbec4"/>
    <keyword color="#cf8e6d"/>
    <lineNumber color="#4b5059"/>
    <localVariable color="#bcbec4"/>
    <localVariableDeclaration color="#bcbec4"/>
    <method color="#bcbec4"/>
    <methodDeclaration color="#56a8f5"/>
    <multiLineComment color="#7a7e85"/>
    <number color="#2aacb8"/>
    <occurrence color="#373b39"/>
    <operator color="#bcbec4"/>
    <removedLine color="#868a91"/>
    <searchResult color="#2d543f"/>
    <selectionBackground color="#214283"/>
    <selectionForeground color="#bcbec4"/>
    <sourceHoverBackground color="#2b2d30"/>
    <staticField color="#c77dbb" italic="true"/>
    <staticFinalField color="#c77dbb" italic="true"/>
    <staticMethod color="#57aaf7" italic="true"/>
    <string color="#6aab73"/>
    <taskTag color="#8bb33d" italic="true"/>
    <templateArgument color="#16baac"/>
    <templateParameter color="#16baac"/>
    <writeOccurrence color="#402f33"/>
    <xmlAttribute color="#bcbec4"/>
    <xmlComment color="#7a7e85"/>
    <xmlTag color="#d5b778"/>
  </editor>
  <workbench>
    <background color="#1e1f22"/>
    <foreground color="#dfe1e5"/>
    <surface color="#2b2d30"/>
    <surfaceRaised color="#1e1f22"/>
    <border color="#1e1f22"/>
    <mutedForeground color="#93969b"/>
    <selection color="#2e436e"/>
    <accent color="#6b9bfa"/>
  </workbench>
</themePackage>
