<?xml version="1.0" encoding="UTF-8"?>
<themePackage schemaVersion="1" id="com.github.eclipsethemes.kintsugi-dark" name="Kintsugi Dark" appearance="dark" author="Ahmed Hatem" website="https://github.com/ahatem/vscode-kintsugi" version="0.3.1">
  <provenance license="MIT" copyright="Ahmed Hatem" source="https://github.com/ahatem/vscode-kintsugi"/>
  <editor>
    <background color="#161618"/>
    <foreground color="#dddddd"/>
    <abstractClass color="#939799"/>
    <abstractMethod color="#dddddd"/>
    <annotation color="#678e87"/>
    <argument color="#dddddd"/>
    <bracket color="#868165"/>
    <class color="#939799"/>
    <comment color="#af9661"/>
    <constant color="#dddddd"/>
    <currentLine color="#1d1d1c"/>
    <deprecated color="#dddddd" strikethrough="true"/>
    <doc color="#af9661"/>
    <docLink color="#dddddd"/>
    <docTag color="#dbad49" bold="true"/>
    <docXmlTag color="#939799"/>
    <enum color="#939799"/>
    <field color="#dddddd"/>
    <filteredSearchResult color="#212326"/>
    <findScope color="#1b1c1f"/>
    <inheritedMethod color="#dddddd"/>
    <interface color="#939799"/>
    <keyword color="#dbad49" bold="true"/>
    <lineNumber color="#444444"/>
    <localVariable color="#dddddd"/>
    <localVariableDeclaration color="#dddddd"/>
    <method color="#dddddd"/>
    <methodDeclaration color="#dddddd"/>
    <multiLineComment color="#af9661"/>
    <number color="#819aff"/>
    <occurrence color="#26292d"/>
    <operator color="#dddddd" bold="true"/>
    <removedLine color="#b38f8f"/>
    <searchResult color="#2c2f35"/>
    <selectionBackground color="#26292d"/>
    <selectionForeground color="#dddddd"/>
    <sourceHoverBackground color="#1c1c1c"/>
    <staticField color="#dddddd"/>
    <staticFinalField color="#dddddd"/>
    <staticMethod color="#dddddd"/>
    <string color="#98c379"/>
    <taskTag color="#af9661" bold="true"/>
    <templateArgument color="#939799"/>
    <templateParameter color="#939799"/>
    <writeOccurrence color="#31353c"/>
    <xmlAttribute color="#dddddd"/>
    <xmlComment color="#af9661"/>
    <xmlTag color="#939799"/>
  </editor>
  <workbench>
    <background color="#161618"/>
    <foreground color="#dddddd"/>
    <surface color="#131314"/>
    <surfaceRaised color="#161618"/>
    <border color="#2a2a28"/>
    <mutedForeground color="#ccccc7"/>
    <selection color="#393b31"/>
    <accent color="#b8943a"/>
  </workbench>
</themePackage>
