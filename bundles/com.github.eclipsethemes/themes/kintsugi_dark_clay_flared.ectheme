<?xml version="1.0" encoding="UTF-8"?>
<themePackage schemaVersion="1" id="com.github.eclipsethemes.kintsugi-dark-clay-flared" name="Kintsugi Dark Clay Flared" appearance="dark" author="Ahmed Hatem" website="https://github.com/ahatem/vscode-kintsugi" version="0.3.1">
  <provenance license="MIT" copyright="Ahmed Hatem" source="https://github.com/ahatem/vscode-kintsugi"/>
  <editor>
    <background color="#0c0c0c"/>
    <foreground color="#bcac8f"/>
    <abstractClass color="#798283"/>
    <abstractMethod color="#798283"/>
    <annotation color="#678e87"/>
    <argument color="#bcac8f"/>
    <bracket color="#85806b"/>
    <class color="#798283"/>
    <comment color="#636363"/>
    <constant color="#bcac8f"/>
    <currentLine color="#161512"/>
    <deprecated color="#bcac8f" strikethrough="true"/>
    <doc color="#636363"/>
    <docLink color="#bcac8f"/>
    <docTag color="#d66848" bold="true"/>
    <docXmlTag color="#dbad49" bold="true"/>
    <enum color="#798283"/>
    <field color="#bcac8f"/>
    <filteredSearchResult color="#181a1c"/>
    <findScope color="#121314"/>
    <inheritedMethod color="#798283"/>
    <interface color="#798283"/>
    <keyword color="#d66848" bold="true"/>
    <lineNumber color="#514e42"/>
    <localVariable color="#bcac8f"/>
    <localVariableDeclaration color="#bcac8f"/>
    <method color="#798283"/>
    <methodDeclaration color="#798283"/>
    <multiLineComment color="#636363"/>
    <number color="#db9833"/>
    <occurrence color="#1e2124"/>
    <operator color="#e08542"/>
    <removedLine color="#b38f8f"/>
    <searchResult color="#24282c"/>
    <selectionBackground color="#1e2124"/>
    <selectionForeground color="#bcac8f"/>
    <sourceHoverBackground color="#181714"/>
    <staticField color="#bcac8f"/>
    <staticFinalField color="#bcac8f"/>
    <staticMethod color="#798283"/>
    <string color="#cc7f66"/>
    <taskTag color="#636363" bold="true"/>
    <templateArgument color="#798283"/>
    <templateParameter color="#798283"/>
    <writeOccurrence color="#2a2f34"/>
    <xmlAttribute color="#798283"/>
    <xmlComment color="#636363"/>
    <xmlTag color="#dbad49" bold="true"/>
  </editor>
  <workbench>
    <background color="#0c0c0c"/>
    <foreground color="#bcac8f"/>
    <surface color="#181714"/>
    <surfaceRaised color="#0c0c0c"/>
    <border color="#2a2a28"/>
    <mutedForeground color="#a9a088"/>
    <selection color="#4a3a18"/>
    <accent color="#b8943a"/>
  </workbench>
</themePackage>
