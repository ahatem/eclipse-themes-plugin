<?xml version="1.0" encoding="UTF-8"?>
<themePackage schemaVersion="1" id="com.github.eclipsethemes.kintsugi-light" name="Kintsugi Light" appearance="light" author="Ahmed Hatem" website="https://github.com/ahatem/vscode-kintsugi" version="0.3.1">
  <provenance license="MIT" copyright="Ahmed Hatem" source="https://github.com/ahatem/vscode-kintsugi"/>
  <editor>
    <background color="#f8f4ea"/>
    <foreground color="#2a2818"/>
    <abstractClass color="#5a6060"/>
    <abstractMethod color="#2a2818"/>
    <annotation color="#47766f"/>
    <argument color="#2a2818"/>
    <bracket color="#746f58"/>
    <class color="#5a6060"/>
    <comment color="#9a8858"/>
    <constant color="#2a2818"/>
    <currentLine color="#eee6d0"/>
    <deprecated color="#2a2818" strikethrough="true"/>
    <doc color="#9a8858"/>
    <docLink color="#2a2818"/>
    <docTag color="#87691c" bold="true"/>
    <docXmlTag color="#5a6060"/>
    <enum color="#5a6060"/>
    <field color="#2a2818"/>
    <filteredSearchResult color="#ece4d1"/>
    <findScope color="#f2ecdd"/>
    <inheritedMethod color="#2a2818"/>
    <interface color="#5a6060"/>
    <keyword color="#87691c" bold="true"/>
    <lineNumber color="#b6b4ac"/>
    <localVariable color="#2a2818"/>
    <localVariableDeclaration color="#2a2818"/>
    <method color="#2a2818"/>
    <methodDeclaration color="#2a2818"/>
    <multiLineComment color="#9a8858"/>
    <number color="#3848a8"/>
    <occurrence color="#eae2cd"/>
    <operator color="#2a2818" bold="true"/>
    <removedLine color="#8a4040"/>
    <searchResult color="#e0d5b7"/>
    <selectionBackground color="#e6ddc4"/>
    <selectionForeground color="#2a2818"/>
    <sourceHoverBackground color="#f3ede4"/>
    <staticField color="#2a2818"/>
    <staticFinalField color="#2a2818"/>
    <staticMethod color="#2a2818"/>
    <string color="#3a6820"/>
    <taskTag color="#9a8858" bold="true"/>
    <templateArgument color="#5a6060"/>
    <templateParameter color="#5a6060"/>
    <writeOccurrence color="#e0d5b7"/>
    <xmlAttribute color="#2a2818"/>
    <xmlComment color="#9a8858"/>
    <xmlTag color="#5a6060"/>
  </editor>
  <workbench>
    <background color="#f8f4ea"/>
    <foreground color="#2a2818"/>
    <surface color="#f2ede4"/>
    <surfaceRaised color="#f8f4ea"/>
    <border color="#ddd4c0"/>
    <mutedForeground color="#6c6a5c"/>
    <selection color="#d8d4c4"/>
    <accent color="#83661c"/>
  </workbench>
</themePackage>
