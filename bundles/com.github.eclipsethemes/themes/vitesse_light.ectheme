<?xml version="1.0" encoding="UTF-8"?>
<themePackage schemaVersion="1" id="com.github.eclipsethemes.vitesse-light" name="Vitesse Light" appearance="light" author="Anthony Fu" website="https://github.com/antfu/vscode-theme-vitesse" version="1.0.1">
  <provenance license="MIT" copyright="Primer; Anthony Fu" source="https://github.com/antfu/vscode-theme-vitesse"/>
  <editor>
    <background color="#ffffff"/>
    <foreground color="#393a34"/>
    <abstractClass color="#5a6aa6"/>
    <abstractMethod color="#59873a"/>
    <annotation color="#59873a"/>
    <argument color="#b07d48"/>
    <bracket color="#999999"/>
    <class color="#5a6aa6"/>
    <comment color="#a0ada0"/>
    <constant color="#998418"/>
    <currentLine color="#f7f7f7"/>
    <deprecated color="#393a34" strikethrough="true"/>
    <doc color="#a0ada0"/>
    <docLink color="#393a34"/>
    <docTag color="#1e754f"/>
    <docXmlTag color="#1e754f"/>
    <enum color="#2e8f82"/>
    <field color="#998418"/>
    <filteredSearchResult color="#f5ebc9"/>
    <findScope color="#e8e8e8"/>
    <inheritedMethod color="#59873a"/>
    <interface color="#2e808f"/>
    <keyword color="#1e754f"/>
    <lineNumber color="#c1c1bf"/>
    <localVariable color="#b07d48"/>
    <localVariableDeclaration color="#b07d48"/>
    <method color="#59873a"/>
    <methodDeclaration color="#59873a"/>
    <multiLineComment color="#a0ada0"/>
    <number color="#2f798a"/>
    <occurrence color="#fbfcfb"/>
    <operator color="#ab5959"/>
    <removedLine color="#ab5959"/>
    <searchResult color="#f8f1db"/>
    <selectionBackground color="#eaeaea"/>
    <selectionForeground color="#393a34"/>
    <sourceHoverBackground color="#ffffff"/>
    <staticField color="#998418"/>
    <staticFinalField color="#998418"/>
    <staticMethod color="#59873a"/>
    <string color="#b56959"/>
    <taskTag color="#a0ada0" bold="true"/>
    <templateArgument color="#2e8f82"/>
    <templateParameter color="#2e8f82"/>
    <writeOccurrence color="#f1f6f4"/>
    <xmlAttribute color="#b07d48"/>
    <xmlComment color="#a0ada0"/>
    <xmlTag color="#1e754f"/>
  </editor>
  <workbench>
    <background color="#ffffff"/>
    <foreground color="#393a34"/>
    <surface color="#ffffff"/>
    <surfaceRaised color="#ffffff"/>
    <border color="#f0f0f0"/>
    <mutedForeground color="#757572"/>
    <selection color="#f7f7f7"/>
    <accent color="#1c6b48"/>
  </workbench>
</themePackage>
